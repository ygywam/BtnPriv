# ==============================================================================
# 북튜닝 개인버전 (Book Tuning Personal) 환경변수 설정 템플릿
# 사용법: 이 파일을 복사해 `.env.local` 파일을 만든 뒤 아래 값을 본인 것으로 채우세요.
# 주의: `.env.local` 파일은 절대 GitHub에 업로드하지 마세요 (.gitignore로 자동 차단됨).
# 배포용 노션 템플릿: https://app.notion.com/p/record-tuner/2a59a421189580169fa9d158783cee29
# ==============================================================================

# 1. 노션(Notion) 공식 API 키 및 4대 데이터베이스 ID (서버 전용, 브라우저 노출 안됨)
NOTION_API_KEY=ntn_your_notion_secret_key_here
NOTION_CHALLENGE_DB_ID=your_32char_challenge_db_id
NOTION_BOOK_DB_ID=your_32char_book_db_id
NOTION_LOG_DB_ID=your_32char_reading_log_db_id
NOTION_INSIGHT_DB_ID=your_32char_insight_db_id

# 2. Google Gemini AI API 키 (AI 독서 리포트 · 블로그 글 · 사진 OCR)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# 3. 도서 검색 및 쪽수 연동 API 키 (카카오 + 국립중앙도서관 표준 하이브리드 엔진)
# - 카카오: 도서 표지 및 기본 서지 검색
# - 국립중앙도서관: 정식 출판 서지정보 기반 전체 페이지수(쪽수) 자동 추출
KAKAO_REST_API_KEY=your_kakao_rest_api_key
NL_API_KEY=your_national_library_key

# (참고) 알라딘(2026.10.30) 및 네이버(2026.07.31) Open API는 서비스가 공식 종료되었습니다.
# ALADIN_API_KEY=your_aladin_ttb_key
# NAVER_CLIENT_ID=your_naver_client_id
# NAVER_CLIENT_SECRET=your_naver_client_secret

# 4. 푸터 '노션 데이터베이스 열기' 바로가기 URL (복제한 내 노션 페이지 주소, 선택)
NOTION_PAGE_URL=https://www.notion.so/your-workspace/your-duplicated-notion-page-id
